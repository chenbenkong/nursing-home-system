<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nursinghome.mapper.CheckInApplicationMapper">

    <resultMap id="ApplicationResultMap" type="com.nursinghome.entity.CheckInApplication">
        <id property="id" column="id"/>
        <result property="applicationNo" column="application_no"/>
        <result property="elderName" column="elder_name"/>
        <result property="gender" column="gender"/>
        <result property="birthDate" column="birth_date"/>
        <result property="idCard" column="id_card"/>
        <result property="phone" column="phone"/>
        <result property="address" column="address"/>
        <result property="contactName" column="contact_name"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="contactRelation" column="contact_relation"/>
        <result property="healthStatus" column="health_status"/>
        <result property="careLevel" column="care_level"/>
        <result property="expectedDate" column="expected_date"/>
        <result property="roomType" column="room_type"/>
        <result property="status" column="status"/>
        <result property="applicantId" column="applicant_id"/>
        <result property="applicantName" column="applicant_name"/>
        <result property="applicantPhone" column="applicant_phone"/>
        <result property="applyTime" column="apply_time"/>
        <result property="approveTime" column="approve_time"/>
        <result property="approveBy" column="approve_by"/>
        <result property="approveRemark" column="approve_remark"/>
        <result property="roomId" column="room_id"/>
        <result property="bedId" column="bed_id"/>
        <result property="checkInDate" column="check_in_date"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectById" resultMap="ApplicationResultMap">
        SELECT * FROM check_in_application WHERE id = #{id}
    </select>

    <select id="selectByApplicationNo" resultMap="ApplicationResultMap">
        SELECT * FROM check_in_application WHERE application_no = #{applicationNo}
    </select>

    <select id="selectAll" resultMap="ApplicationResultMap">
        SELECT * FROM check_in_application ORDER BY create_time DESC
    </select>

    <select id="selectByStatus" resultMap="ApplicationResultMap">
        SELECT * FROM check_in_application WHERE status = #{status} ORDER BY create_time DESC
    </select>

    <select id="selectByCondition" resultMap="ApplicationResultMap">
        SELECT * FROM check_in_application
        <where>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="elderName != null and elderName != ''">
                AND elder_name LIKE CONCAT('%', #{elderName}, '%')
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO check_in_application (application_no, elder_name, gender, birth_date, id_card, phone, address,
                                         contact_name, contact_phone, contact_relation, health_status, care_level,
                                         expected_date, room_type, status, applicant_id, applicant_name, applicant_phone,
                                         approve_remark, room_id, bed_id, check_in_date)
        VALUES (#{applicationNo}, #{elderName}, #{gender}, #{birthDate}, #{idCard}, #{phone}, #{address},
                #{contactName}, #{contactPhone}, #{contactRelation}, #{healthStatus}, #{careLevel},
                #{expectedDate}, #{roomType}, #{status}, #{applicantId}, #{applicantName}, #{applicantPhone},
                #{approveRemark}, #{roomId}, #{bedId}, #{checkInDate})
    </insert>

    <update id="update">
        UPDATE check_in_application
        <set>
            <if test="elderName != null">elder_name = #{elderName},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="birthDate != null">birth_date = #{birthDate},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="address != null">address = #{address},</if>
            <if test="contactName != null">contact_name = #{contactName},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="contactRelation != null">contact_relation = #{contactRelation},</if>
            <if test="healthStatus != null">health_status = #{healthStatus},</if>
            <if test="careLevel != null">care_level = #{careLevel},</if>
            <if test="expectedDate != null">expected_date = #{expectedDate},</if>
            <if test="roomType != null">room_type = #{roomType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="applicantId != null">applicant_id = #{applicantId},</if>
            <if test="applicantName != null">applicant_name = #{applicantName},</if>
            <if test="applicantPhone != null">applicant_phone = #{applicantPhone},</if>
            <if test="approveTime != null">approve_time = #{approveTime},</if>
            <if test="approveBy != null">approve_by = #{approveBy},</if>
            <if test="approveRemark != null">approve_remark = #{approveRemark},</if>
            <if test="roomId != null">room_id = #{roomId},</if>
            <if test="bedId != null">bed_id = #{bedId},</if>
            <if test="checkInDate != null">check_in_date = #{checkInDate}</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM check_in_application WHERE id = #{id}
    </delete>

    <select id="countByStatus" resultType="java.lang.Long">
        SELECT COUNT(*) FROM check_in_application WHERE status = #{status}
    </select>

</mapper>
