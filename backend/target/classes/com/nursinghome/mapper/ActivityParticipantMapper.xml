<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nursinghome.mapper.ActivityParticipantMapper">

    <resultMap id="BaseResultMap" type="com.nursinghome.entity.ActivityParticipant">
        <id column="id" property="id"/>
        <result column="activity_id" property="activityId"/>
        <result column="elder_id" property="elderId"/>
        <result column="elder_name" property="elderName"/>
        <result column="sign_up_time" property="signUpTime"/>
        <result column="sign_in_time" property="signInTime"/>
        <result column="status" property="status"/>
        <result column="feedback" property="feedback"/>
        <result column="satisfaction" property="satisfaction"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, activity_id, elder_id, elder_name, sign_up_time, sign_in_time,
        status, feedback, satisfaction, create_time
    </sql>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM activity_participant
        ORDER BY create_time DESC
    </select>

    <select id="selectByActivityId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM activity_participant
        WHERE activity_id = #{activityId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByElderId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM activity_participant
        WHERE elder_id = #{elderId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM activity_participant
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM activity_participant
        WHERE id = #{id}
    </select>

    <select id="selectByActivityIdAndElderId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM activity_participant
        WHERE activity_id = #{activityId} AND elder_id = #{elderId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO activity_participant (
            activity_id, elder_id, elder_name, status
        ) VALUES (
            #{activityId}, #{elderId}, #{elderName}, #{status}
        )
    </insert>

    <update id="update">
        UPDATE activity_participant
        <set>
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="elderId != null">elder_id = #{elderId},</if>
            <if test="elderName != null">elder_name = #{elderName},</if>
            <if test="signUpTime != null">sign_up_time = #{signUpTime},</if>
            <if test="signInTime != null">sign_in_time = #{signInTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="feedback != null">feedback = #{feedback},</if>
            <if test="satisfaction != null">satisfaction = #{satisfaction}</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM activity_participant WHERE id = #{id}
    </delete>

    <delete id="deleteByActivityId">
        DELETE FROM activity_participant WHERE activity_id = #{activityId}
    </delete>

    <select id="countAll" resultType="java.lang.Long">
        SELECT COUNT(*) FROM activity_participant
    </select>

    <select id="countByActivityId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM activity_participant WHERE activity_id = #{activityId}
    </select>

    <select id="countByElderId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM activity_participant WHERE elder_id = #{elderId}
    </select>

</mapper>
