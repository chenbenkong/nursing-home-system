<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nursinghome.mapper.InventoryMapper">

    <resultMap id="BaseResultMap" type="com.nursinghome.entity.Inventory">
        <id column="id" property="id"/>
        <result column="item_no" property="itemNo"/>
        <result column="item_name" property="itemName"/>
        <result column="category" property="category"/>
        <result column="specification" property="specification"/>
        <result column="unit" property="unit"/>
        <result column="stock_quantity" property="stockQuantity"/>
        <result column="min_stock" property="minStock"/>
        <result column="max_stock" property="maxStock"/>
        <result column="storage_location" property="storageLocation"/>
        <result column="supplier" property="supplier"/>
        <result column="price" property="price"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, item_no, item_name, category, specification, unit, stock_quantity, min_stock, max_stock,
        storage_location, supplier, price, status, create_time, update_time, remark
    </sql>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM inventory
        ORDER BY create_time DESC
    </select>

    <select id="selectByCategory" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM inventory
        WHERE category = #{category}
        ORDER BY create_time DESC
    </select>

    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM inventory
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>

    <select id="selectByItemName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM inventory
        WHERE item_name LIKE CONCAT('%', #{itemName}, '%')
        ORDER BY create_time DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM inventory
        WHERE id = #{id}
    </select>

    <select id="selectByItemNo" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM inventory
        WHERE item_no = #{itemNo}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO inventory (
            item_no, item_name, category, specification, unit, stock_quantity, min_stock, max_stock,
            storage_location, supplier, price, status, remark
        ) VALUES (
            #{itemNo}, #{itemName}, #{category}, #{specification}, #{unit}, #{stockQuantity}, #{minStock}, #{maxStock},
            #{storageLocation}, #{supplier}, #{price}, #{status}, #{remark}
        )
    </insert>

    <update id="update">
        UPDATE inventory
        <set>
            <if test="itemName != null">item_name = #{itemName},</if>
            <if test="category != null">category = #{category},</if>
            <if test="specification != null">specification = #{specification},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="stockQuantity != null">stock_quantity = #{stockQuantity},</if>
            <if test="minStock != null">min_stock = #{minStock},</if>
            <if test="maxStock != null">max_stock = #{maxStock},</if>
            <if test="storageLocation != null">storage_location = #{storageLocation},</if>
            <if test="supplier != null">supplier = #{supplier},</if>
            <if test="price != null">price = #{price},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark}</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM inventory WHERE id = #{id}
    </delete>

    <select id="countAll" resultType="java.lang.Long">
        SELECT COUNT(*) FROM inventory
    </select>

    <select id="countByCategory" resultType="java.lang.Long">
        SELECT COUNT(*) FROM inventory WHERE category = #{category}
    </select>

    <select id="countByStatus" resultType="java.lang.Long">
        SELECT COUNT(*) FROM inventory WHERE status = #{status}
    </select>

    <select id="selectLowStock" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM inventory
        WHERE stock_quantity &lt;= min_stock AND status != 'DISCONTINUED'
        ORDER BY stock_quantity ASC
    </select>

</mapper>
